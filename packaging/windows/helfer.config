<?xml version="1.0" encoding="utf-8"?>
<!--

  Die Einstellungen, mit denen unser Installer die Messhilfe ablegt.

  LibreHardwareMonitor liest diese Datei beim Start aus dem eigenen Ordner
  (LibreHardwareMonitor.config) und kennt genau diese Schluessel:

    runWebServerMenuItem  Web-Server gleich beim Start an  (Standard: aus)
    listenerPort          Adresse, ueber die wir fragen    (Standard: 8085)
    startMinMenuItem      Fenster nie zeigen, nur im Symbolbereich
    minTrayMenuItem       Knopf "Zu" versteckt im Symbolbereich statt beendet

  Damit ist nach der Installation nichts mehr anzuklicken: llano fragt auf
  127.0.0.1:8085/data.json nach, die Messhilfe antwortet, und die
  Prozessortemperatur steht in der Auswahl. Wer den Web-Server in der
  Messhilfe selbst abschaltet, schaltet nur diese Quelle ab - der Rest von
  llano arbeitet unveraendert weiter.

-->
<configuration>
  <appSettings>
    <add key="runWebServerMenuItem" value="True" />
    <add key="listenerPort" value="8085" />
    <add key="startMinMenuItem" value="True" />
    <add key="minTrayMenuItem" value="True" />
  </appSettings>
</configuration>
